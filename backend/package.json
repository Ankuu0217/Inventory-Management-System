{
  "name": "inventory-management-backend",
  "version": "1.0.0",
  "description": "REST API backend for an Inventory Management System",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage"
  },
  "dependencies": {
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "mongoose": "9.9.5",
    "morgan": "1.12.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "winston": "3.19.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "jest": "30.5.1",
    "mongodb-memory-server": "11.2.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "supertest": "7.2.2"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
